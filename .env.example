# Desktop download links shown on the web (ExternalActionLink buttons in
# src/components/web-tools/web-tools-shell.tsx). Point these at GitHub
# Releases' "latest" alias so the web NEVER needs to change on every new
# version — GitHub resolves /releases/latest/download/<asset> to whatever
# release is currently marked "Latest" server-side. Vercel does not store
# these binaries; it only renders the links. See docs/release/ for the
# publishing flow that keeps the "Latest" release current.
#
# Windows user product = Setup.exe (installer). macOS user product = DMG
# (Apple Silicon). Windows/macOS "portable" builds are internal build
# payload only and are never linked from the web.
NEXT_PUBLIC_LINUX_DOWNLOAD_URL=https://github.com/ToniIAPro73/anclora-filestudio/releases/latest/download/Anclora-FileStudio-Linux-x64.tar.zst
NEXT_PUBLIC_MACOS_DOWNLOAD_URL=https://github.com/ToniIAPro73/anclora-filestudio/releases/latest/download/Anclora-FileStudio-macOS-arm64.dmg
NEXT_PUBLIC_SUPPORT_URL=
