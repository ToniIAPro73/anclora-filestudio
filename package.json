{
  "name": "anclora-filestudio",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/integrations/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "build:vercel": "ANCLORA_FILESTUDIO_DEPLOYMENT_TARGET=vercel NEXT_PUBLIC_ANCLORA_FILESTUDIO_MODE=vercel-web NEXT_PUBLIC_ENABLE_BROWSER_DATA_CONVERSIONS=true ANCLORA_FILESTUDIO_ENABLE_SERVER_CONVERSIONS=false ANCLORA_FILESTUDIO_ENABLE_CLOUD_UPLOADS=false next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:engines": "vitest run --config vitest.engines.config.ts",
    "test:security": "vitest run --config vitest.security.config.ts",
    "test:operations": "vitest run --config vitest.operations.config.ts",
    "test:automation": "vitest run --config vitest.automation.config.ts",
    "test:background-removal": "vitest run --config vitest.background-removal.config.ts",
    "test:alpha-channel": "vitest run --config vitest.alpha-channel.config.ts",
    "test:vision-pack": "vitest run --config vitest.vision-pack.config.ts",
    "test:core": "vitest run --config vitest.core.config.ts",
    "test:sdk": "vitest run --config vitest.sdk.config.ts",
    "test:api": "corepack pnpm@10.33.2 --filter @anclora/filestudio-api test",
    "test:contracts": "corepack pnpm@10.33.2 run test:nexus-contract",
    "test:desktop": "vitest run",
    "test:openapi": "corepack pnpm@10.33.2 run test:nexus-contract",
    "test:persistence": "corepack pnpm@10.33.2 --filter @anclora/filestudio-core test",
    "test:queue": "corepack pnpm@10.33.2 --filter @anclora/filestudio-worker test",
    "test:storage": "corepack pnpm@10.33.2 --filter @anclora/filestudio-worker test",
    "test:workers": "corepack pnpm@10.33.2 --filter @anclora/filestudio-worker test",
    "test:concurrency": "corepack pnpm@10.33.2 --filter @anclora/filestudio-worker test",
    "test:cleanup": "vitest run tests/unit/coordinated-cleanup.test.ts tests/unit/disk-space-check.test.ts",
    "test:auth": "corepack pnpm@10.33.2 --filter @anclora/filestudio-api test -- tests/auth.test.ts",
    "test:authorization": "corepack pnpm@10.33.2 --filter @anclora/filestudio-api test -- tests/auth.test.ts tests/agent.test.ts",
    "test:webhooks": "corepack pnpm@10.33.2 --filter @anclora/filestudio-api test -- tests/webhook.test.ts",
    "test:ssrf": "corepack pnpm@10.33.2 --filter @anclora/filestudio-api test -- tests/webhook.test.ts",
    "test:rate-limit": "corepack pnpm@10.33.2 --filter @anclora/filestudio-api test -- tests/observability.test.ts",
    "test:service:e2e": "corepack pnpm@10.33.2 --filter @anclora/filestudio-local-agent test -- tests/smoke.test.ts",
    "test:local-agent": "corepack pnpm@10.33.2 --filter @anclora/filestudio-local-agent test",
    "test:pairing": "corepack pnpm@10.33.2 --filter @anclora/filestudio-local-agent test -- tests/pairing.test.ts",
    "test:routing": "corepack pnpm@10.33.2 --filter @anclora/filestudio-nexus test -- tests/routing-policy.test.ts",
    "test:nexus-contract": "corepack pnpm@10.33.2 --filter @anclora/filestudio-nexus test -- tests/contract.test.ts",
    "test:privacy": "corepack pnpm@10.33.2 --filter @anclora/filestudio-local-agent test -- tests/consent.test.ts tests/credential-store.test.ts",
    "test:e2e": "playwright test",
    "test:vercel": "vitest run tests/vercel",
    "test:web-images": "vitest run tests/vercel/web-phase1-capabilities.test.ts",
    "test:web-pdf": "vitest run tests/vercel/web-phase1-capabilities.test.ts",
    "test:web-privacy": "vitest run tests/vercel/web-phase1-privacy.test.ts",
    "test:web-phase1": "corepack pnpm@10.33.2 run test:web-images && corepack pnpm@10.33.2 run test:web-pdf && corepack pnpm@10.33.2 run test:web-privacy",
    "test:desktop-pro": "vitest run tests/desktop-pro",
    "build:desktop": "next build",
    "build:service": "corepack pnpm@10.33.2 --filter @anclora/filestudio-api build",
    "build:local-agent": "corepack pnpm@10.33.2 --filter @anclora/filestudio-local-agent build",
    "build:portable:windows": "bash scripts/build-windows-portable.sh",
    "build:portable:linux": "bash scripts/build-linux-portable.sh",
    "verify:portable:windows": "bash scripts/verify-windows-portable-v2.sh",
    "verify:portable:linux": "bash scripts/verify-linux-portable.sh",
    "smoke:portable:windows": "bash scripts/smoke-windows-portable.sh",
    "smoke:portable:linux": "bash scripts/smoke-linux-portable.sh",
    "test:acceptance:fixtures": "node scripts/acceptance/generate-fixtures.mjs",
    "test:acceptance:api": "node scripts/acceptance/run-conversion-suite.mjs",
    "test:acceptance:linux": "bash scripts/acceptance/run-linux-portable-e2e.sh",
    "test:acceptance:windows": "bash scripts/acceptance/run-windows-portable-e2e.sh",
    "test:acceptance:compare": "node scripts/acceptance/compare-platform-results.mjs",
    "smoke:local-agent": "corepack pnpm@10.33.2 run test:local-agent -- tests/smoke.test.ts",
    "smoke:service": "corepack pnpm@10.33.2 run test:service:e2e",
    "generate:sbom": "node scripts/generate-sbom.mjs",
    "audit:licenses": "node scripts/audit-licenses.mjs",
    "check": "eslint . && tsc --noEmit && vitest run && next build",
    "check:deps": "node scripts/check-dependencies.mjs",
    "verify:vercel": "ANCLORA_FILESTUDIO_DEPLOYMENT_TARGET=vercel NEXT_PUBLIC_ANCLORA_FILESTUDIO_MODE=vercel-web node scripts/verify-vercel-bundle.mjs",
    "deploy:vercel:preview": "vercel deploy",
    "deploy:vercel:production": "vercel deploy --prod",
    "cleanup": "node scripts/cleanup-temp.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "better-sqlite3": "^12.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.0",
    "csv-stringify": "^6.8.0",
    "exifr": "7.1.3",
    "fast-xml-parser": "^5.8.0",
    "fflate": "0.8.3",
    "file-type": "^22.0.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.18.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.62.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.1",
    "smol-toml": "^1.6.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/csv-parse": "^1.2.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sharp": "^0.32.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "0.35.1"
  }
}
